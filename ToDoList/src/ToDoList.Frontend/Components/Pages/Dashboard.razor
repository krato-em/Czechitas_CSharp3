    private List<ToDoItemView> sortedData = new();
    private bool isAscencingId = true;
    private bool isAscendingName = true;
    private void SortById()
    {
        if (isAscencingId)
        {
            sortedData = sortedData.OrderByDescending(item => item.Id).ToList();
            isAscencingId = false;
        }
        else
        {
            sortedData = sortedData.OrderBy(item => item.Id).ToList();
            isAscencingId = true;
        }
    }

    private void SortByName()
    {
        if (isAscendingName)
        {
            sortedData = sortedData.OrderByDescending(item => item.Name).ToList();
            isAscendingName = false;
        }
        else
        {
            sortedData = sortedData.OrderBy(item => item.Name).ToList();
            isAscendingName = true;
        }
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"/editToDoItem/{toDoItem.Id}");
    }
    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }

    //ToDo: add method to show only not-completed items + method that shows all items again
}
