@using ToDoList.Domain.Models
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Views

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div>
    <h2>Dashboard</h2>

    <table class="table table-hove mt-3r">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Descriptioin</th>
                <th>Completed?</th>
                <th>Actions</th>
            </tr>
            @* <tr>
            <td><button @onclick="SortById">Sort By ID</button></td>
            <td><button @onclick="SortByName">Sort By Name</button></td>
        </tr> *@
        </thead>
        <thead>
            <tr>
                <td><button class="btn btn-primary" @onclick="SortById">Sort By ID</button></td>
                <td><button class="btn btn-secondary" @onclick="SortByName">Sort By Name</button></td>
                <td></td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-light">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Finished" : "Not finished")</td>
                    <td><button class="btn btn-success" @onclick="() => EditItem(item)">Edit</button></td>
                </tr>

            }
        </tbody>
    </table>
</div>

@code {
    @* private List<ToDoItemView> testData = new()
{
new ToDoItemView( 1, "Nakoupit potraviny", "Mléko, chléb, vejce", false),
